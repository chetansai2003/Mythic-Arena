# Mythic Arena Production Environment Configuration Example
# Copy to .env.production on production servers. Never commit secrets to source control.

NODE_ENV=production
HOST=0.0.0.0
API_PORT=3001
WORKER_PORT=3002

# Managed cloud Redis connection (use rediss:// for TLS-encrypted connections)
REDIS_URL=rediss://default:secret-redis-password@redis-cluster.example.com:6379

# Managed MongoDB replica set connection (Atlas or self-managed replica set)
MONGODB_URI=mongodb+srv://mythic_app:secret-db-password@cluster.example.com/mythic_arena?retryWrites=true&w=majority
MONGODB_DB=mythic_arena

# Allowed production HTTPS frontend origins (comma-separated if multiple)
FRONTEND_ORIGINS=https://arena.example.com

# Logging level: error, warn, info, or debug
LOG_LEVEL=info

# 64-character minimum cryptographic secret for JWT signing and token families
AUTH_SECRET=9d8f7b2c5e4a106385a2c4e6f8d0b2a4c6e8f0a2b4d6e8c0a2f4e6d8b0c2a4e6

# Session lifetimes
ACCESS_TOKEN_SECONDS=600
REFRESH_DAYS=7

# Release identifier tracking the deployed git sha or release tag
RELEASE_VERSION=2026.09.15
